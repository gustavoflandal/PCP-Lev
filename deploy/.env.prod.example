# Copie para deploy/.env.prod (fora do git) e preencha. Gere cada segredo na
# propria maquina de producao; nunca reaproveite os de outro ambiente.

# Nome pelo qual os usuarios acessam o sistema (sem https://).
PCP_DOMINIO=pcp.empresa.local
# Certificado: internal | e-mail para Let's Encrypt | /certs/cert.pem /certs/key.pem
PCP_TLS=internal
# Portas publicadas no servidor (padrao 80/443)
HTTP_PORT=80
HTTPS_PORT=443

DB_NAME=pcp_db
# Superusuario do Postgres: so manutencao e backup (openssl rand -base64 24)
DB_ADMIN_USER=pcp_admin
DB_ADMIN_PASSWORD=
# Papel com que a API conecta, sem superusuario (openssl rand -base64 24)
DB_USER=pcp_app
DB_PASSWORD=

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32 -- cifra a senha do SMTP. Guarde junto do backup:
# sem ela, a senha do SMTP restaurada nao decifra (basta digita-la de novo).
CHAVE_MESTRA_SEGREDOS=

JWT_EXPIRE_HOURS=8
LOG_LEVEL=info

# Backup diario
BACKUP_HORA=02
BACKUP_RETENCAO_DIAS=14
BACKUP_DIR=./backups

# Tag das imagens geradas (ex.: v1.2.0)
PCP_VERSAO=local
