# ============ Banco de Dados ============
DB_HOST=localhost
DB_PORT=5442
DB_USER=pcp_user
DB_PASSWORD=senha_segura
DB_NAME=pcp_db
DB_SSLMODE=disable
DB_MAX_CONNS=20

# ============ Autenticação ============
# Obrigatorio, sem valor padrao. Gere um por ambiente: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRE_HOURS=8

# ============ API ============
API_PORT=8000
API_ENV=development
CORS_ORIGENS=http://localhost:3010,http://localhost:5173
LOG_LEVEL=info

# Rate limiting (0 desliga): requisicoes/s e rajada por usuario ou IP, e
# tentativas de login por minuto por IP.
RATE_LIMIT_RPS=20
RATE_LIMIT_RAJADA=60
RATE_LIMIT_LOGIN_POR_MINUTO=5

# Chave mestra (base64 de 32 bytes) que cifra segredos de terceiros, como a
# senha do SMTP. GERE UMA PROPRIA POR AMBIENTE: openssl rand -base64 32
# Nunca reaproveite a de outro ambiente nem a publique. Vazia, o sistema
# funciona, mas a tela de Integracoes recusa gravar senha de SMTP.
CHAVE_MESTRA_SEGREDOS=

# ============ Frontend ============
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Sistema PCP
FRONTEND_PORT=3010
